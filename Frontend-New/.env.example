# Frontend-New environment — copy to `.env` and fill in.
# Only VITE_-prefixed variables are exposed to the browser bundle.
# Never put secrets here: everything in this file ships to the client.

# Backend API base URL.
VITE_API_URL=http://localhost:8000

# Google OAuth *public* client ID (not the client secret).
VITE_GOOGLE_CLIENT_ID=

# ── Company identity ────────────────────────────────────────────────────────
# Read by src/lib/brand.ts. These appear on invoices and legal pages, so they
# must match the entity that actually issues receipts. Leaving them unset makes
# the invoice generator stamp the PDF as a draft rather than quietly printing a
# placeholder address on a document a customer may submit for tax purposes.

# Product name and positioning line.
VITE_APP_NAME=InfiChat
VITE_APP_TAGLINE=AI assistant for teams

# Registered legal entity — often different from the product name.
VITE_LEGAL_ENTITY_NAME=

# Registered address. Newline- or pipe-separated, printed one line each.
# Example: VITE_LEGAL_ADDRESS="Suite 100, 1 Example Street|Bengaluru 560001|India"
VITE_LEGAL_ADDRESS=

# Company registration number and tax identifier (VAT / GSTIN / EIN).
# Omitted from the invoice entirely when blank.
VITE_LEGAL_REGISTRATION_NUMBER=
VITE_LEGAL_TAX_ID=

# Public website (no scheme) and contact addresses.
VITE_PUBLIC_WEBSITE=infichat.ai
VITE_BILLING_EMAIL=billing@infichat.ai
VITE_SUPPORT_EMAIL=support@infichat.ai
VITE_PRIVACY_EMAIL=privacy@infichat.ai
VITE_SECURITY_EMAIL=security@infichat.ai

# Named on receipts so customers can match the card-statement descriptor.
VITE_PAYMENT_PROCESSOR=Stripe
