# Local development only. The Vite dev server proxies /api to the backend
# (see vite.config.ts), so the default below is the same-origin path and
# requires no CORS grant from the backend.
#
# Point this at an absolute URL only if you are running the console against a
# backend that is not reachable through the dev proxy.
VITE_API_URL=/api

# Where the dev proxy forwards /api. The backend listens on 8000 — NOT 8080,
# which is SearXNG in docker-compose.yml.
VITE_DEV_API_TARGET=http://localhost:8000
