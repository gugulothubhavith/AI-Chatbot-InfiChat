# ==============================================================================
# INFICHAT COMPREHENSIVE MODEL MANIFEST (.env.models)
# ==============================================================================
# This file serves as the definitive reference for every AI model integrated 
# into the Chatbot-InfiChat ecosystem. It details the exact models used for 
# specific features (Chat, Vision, Deep Research, Web Search, Multi-Agent), 
# their purpose, and their designated API providers.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DEFAULT CHAT (User-Facing General Conversation)
# ------------------------------------------------------------------------------
# Model: NVIDIA Nemotron 3 Super 120B
# Provider: NVIDIA NIM (NVIDIA API)
# Fallback Providers: Groq / OpenRouter
# Purpose: This is the primary, default workhorse for the application. When a 
# user opens a new chat without explicitly changing settings, this model handles 
# the conversation. It is responsible for generic Q&A, brainstorming, text 
# generation, and maintaining the primary chat interface.
DEFAULT_CHAT_MODEL="nvidia/nemotron-3-ultra-550b-a55b"

# Model: Llama 3.3 70B Versatile
# Provider: Groq API
# Purpose: This model is used when lightning-fast responses are required, or 
# as a robust fallback for legacy endpoints. It powers the high-speed text 
# generation capabilities accessible from the model dropdown.
GROQ_WORKHORSE_MODEL="llama-3.1-70b-versatile"

# Additional Chat Models
CHAT_MODEL_LLAMA_3_1="meta/llama-3.1-70b-instruct"
CHAT_MODEL_DEEPSEEK="openai/gpt-oss-120b"


# ------------------------------------------------------------------------------
# 2. DEEP RESEARCH PIPELINE
# ------------------------------------------------------------------------------
# Model: NVIDIA Nemotron 3 Super 120B (Default) or Llama 3.3 70B (Bypass)
# Provider: NVIDIA NIM or Groq
# Purpose: The Deep Research feature performs exhaustive, multi-step internet 
# research. It recursively searches the web, analyzes massive amounts of 
# retrieved documents, and compiles comprehensive reports. 
# It utilizes the DEFAULT_CHAT_MODEL by default to synthesize complex findings, 
# but uses the internal alias "dr_large_2" or "llama-3.3-70b-groq-direct" when 
# high-speed processing is required for the intermediary research loops.
DEEP_RESEARCH_DEFAULT_MODEL="nvidia/nemotron-3-ultra-550b-a55b"
DEEP_RESEARCH_FAST_LOOP_MODEL="openai/gpt-oss-120b"

# ------------------------------------------------------------------------------
# 3. FAST WEB SEARCH AGENT
# ------------------------------------------------------------------------------
# Model: NVIDIA Nemotron Super 49B
# Provider: NVIDIA NIM
# Purpose: Used by the real-time Web Search feature. When a user asks a question
# requiring up-to-date internet knowledge, this model is invoked to read the 
# search results and quickly generate a synthesized answer with inline citations.
WEB_SEARCH_MODEL="nvidia/llama-3_3-nemotron-super-49b-v1_5"

# ------------------------------------------------------------------------------
# 4. VISION & MULTI-MODAL (Image Understanding)
# ------------------------------------------------------------------------------
# Model: Gemini 1.5 Flash / Gemini 3 Flash Preview
# Provider: Google Gemini API (v1beta)
# Purpose: Exclusively handles image processing. Whenever a user uploads a 
# screenshot, photo, or image to the chat, the system automatically routes the 
# request to these Gemini models. They "see" the image, analyze its contents, 
# read text (OCR), and provide visual context back to the user.
VISION_MODEL="gemini-1.5-flash"
VISION_PREVIEW_MODEL="gemini-3-flash-preview"

# ------------------------------------------------------------------------------
# 5. MULTI-AGENT SQUAD (Autonomous Task Delegation)
# ------------------------------------------------------------------------------
# The Multi-Agent system utilizes specialized models for different roles within 
# an autonomous team.

# Role: THE PLANNER (Project Manager)
# Model: z-ai/glm-5.2
# Provider: z-ai infrastructure / NVIDIA NIM
# Purpose: Receives the initial complex prompt from the user, breaks it down 
# into actionable steps, and delegates tasks to the Coder or Reviewer agents.
PLANNER_MODEL="z-ai/glm-5.2"

# Role: THE CODER (Software Engineer)
# Model: z-ai/glm-5.2
# Provider: OpenRouter / NVIDIA NIM / z-ai infrastructure
# Purpose: Strictly prompted to write, debug, and execute code. It receives 
# instructions from the Planner, writes the implementation, and runs the code 
# in the background sandbox.
CODER_MODEL="z-ai/glm-5.2"

# ------------------------------------------------------------------------------
# 6. BACKGROUND MEMORY EXTRACTION
# ------------------------------------------------------------------------------
# Model: NVIDIA Nemotron 3 Ultra 550B
# Provider: NVIDIA NIM
# Purpose: Runs silently in the background while the user chats. It continuously
# analyzes the conversation to extract user facts, preferences, and long-term 
# memory points to save to the database, ensuring the bot remembers the user 
# across different sessions.
MEMORY_EXTRACTOR_MODEL="nvidia/nemotron-3-ultra-550b-a55b"

# ------------------------------------------------------------------------------
# 7. RAG / KNOWLEDGE BASE (Document Embedding & Reranking)
# ------------------------------------------------------------------------------
# Model: BAAI/bge-small-en-v1.5
# Provider: Local / HuggingFace Inference
# Purpose: The default embedding model. Converts uploaded PDF/TXT documents 
# into mathematical vectors so they can be stored in the vector database and 
# queried later via semantic search.
EMBEDDING_MODEL_DEFAULT="BAAI/bge-small-en-v1.5"

# Model: voyage-3
# Provider: Voyage AI API
# Purpose: A premium embedding alternative for highly accurate, enterprise-grade 
# document search and vectorization.
EMBEDDING_MODEL_PREMIUM="voyage-3"

# Model: rerank-2.5
# Provider: Voyage AI API
# Purpose: A reranking model. After the vector database finds matches, this 
# model re-reads and re-evaluates the retrieved document chunks to ensure only 
# the most relevant context is fed into the LLM.
RERANK_MODEL="rerank-2.5"

# ------------------------------------------------------------------------------
# 8. VOICE AND AUDIO (Speech processing)
# ------------------------------------------------------------------------------
# Model: whisper-large-v3 / whisper-large-v3-turbo
# Provider: Groq API
# Purpose: Speech-to-Text (STT). Listens to user voice recordings and microphone 
# input, transcribing spoken words into text instantly.
STT_MODEL_PRIMARY="whisper-large-v3"
STT_MODEL_FAST="whisper-large-v3-turbo"

# Model: Sierra
# Provider: Unreal Speech API
# Purpose: Text-to-Speech (TTS). Reads the AI's generated text responses out 
# loud to the user with natural, human-like pacing and intonation.
TTS_VOICE_MODEL="Sierra"

# ------------------------------------------------------------------------------
# 9. CREATIVE GENERATION (Images)
# ------------------------------------------------------------------------------
# Model: black-forest-labs/flux-1-schnell
# Provider: NVIDIA API
# Purpose: Text-to-Image generation. When the user explicitly requests to 
# "draw", "generate", or "create an image of", this model receives the prompt 
# and produces inline visual artwork.
IMAGE_GENERATION_MODEL="black-forest-labs/flux-1-schnell"

# ==============================================================================
# END OF COMPREHENSIVE MODEL MANIFEST
# ==============================================================================
