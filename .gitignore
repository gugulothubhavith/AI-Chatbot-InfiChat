# ══════════════════════════════════════════════════════════════════════════════
# §2  SECRETS, KEYS & ENVIRONMENT FILES
#     Deny-by-pattern, not by filename.
#     .env.example / .env.template / .env.sample are re-included at the bottom.
# ══════════════════════════════════════════════════════════════════════════════

# Every .env variant everywhere in the tree
**/.env
**/.env.*
**/*.env

# Specific known locations (belt-and-suspenders)
.env
backend/.env
Frontend-New/.env
admin-frontend/.env

# Re-include safe templates
!**/.env.example
!**/.env.template
!**/.env.sample
!**/.env.compose.example

# Documentation-only model manifest — no credentials
!.env.models


# ══════════════════════════════════════════════════════════════════════════════
# §3  DATABASE FILES, SCHEMAS & MIGRATION SCRIPTS
# ══════════════════════════════════════════════════════════════════════════════

# Proprietary schema and one-off automation scripts
backend/schema.sql
backend/fix_db_schema.py
backend/fix_auth.py
backend/fix_imports.py
backend/check_cols.py
backend/debug_login.py
backend/debug.py
backend/migrate_releases.py
backend/migrate_sqlite_to_postgres.py
backend/update_json_parsing.py
backend/update_plans.py
backend/verify_imports.py

# Alembic: ignore only local caches, keep the migrations themselves tracked
backend/alembic/**/__pycache__/
backend/alembic/versions/*.pyc

# SQLite database files (local dev — never commit a live database)
**/*.db
**/*.db-shm
**/*.db-wal
**/*.sqlite
**/*.sqlite3

# Redis dump
dump.rdb
**/dump.rdb


