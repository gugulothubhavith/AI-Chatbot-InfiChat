# ══════════════════════════════════════════════════════════════════════════════

.claude/settings.local.json
.claude/**/*.local.*
**/.aider*
**/.cursorignore
**/.cursorindexingignore
**/.continue/
**/.codeium/
**/.copilot/
.agents/


# ══════════════════════════════════════════════════════════════════════════════
# §13 ARCHIVES, DUMPS & BACKUPS
#     A database dump is the highest-value accidental commit.
# ══════════════════════════════════════════════════════════════════════════════

**/*.sql.gz
**/*.dump
**/*.bak
**/*.tar.gz
**/*.tar.bz2
**/*.tar.xz
**/*.zip
**/*.7z
**/*.rar

# Re-include any intentional zip assets in docs
!**/docs/**/*.zip


