# InfiChat — environment overrides for docker compose.
#
# Copy to `.env` in this directory (next to docker-compose.yml) and fill in
# what you need. Compose reads this file automatically; anything left blank
# falls back to the defaults in docker-compose.yml.
#
#   cp .env.example .env
#
# Never commit `.env` — it holds live client secrets.

# ---------------------------------------------------------------------------
# Connectors (Phase 6)
# ---------------------------------------------------------------------------
# Every provider below shows as "Not set up on this server" until BOTH its
# CLIENT_ID and CLIENT_SECRET are filled in. That is deliberate: the UI states
# what the platform supports and disables the button, rather than offering a
# Connect that cannot work.
#
# THE REDIRECT URI, which every provider will ask you to register, is:
#
#   http://localhost:5173/api/v1/connectors/callback
#
# It must match exactly — scheme, host, port and path. Change PUBLIC_BASE_URL
# below for a real deployment and re-register the new URI everywhere.
PUBLIC_BASE_URL=http://localhost:5173

# Encrypts stored OAuth tokens. A dev key ships in docker-compose.yml; generate
# your own for anything real:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this makes existing connections unreadable — they move to
# NEEDS_REAUTH and users reconnect.
CONNECTOR_ENCRYPTION_KEY=

# --- Code ---
# https://github.com/settings/developers → New OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# https://gitlab.com/-/profile/applications  (scopes: read_api, read_user)
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# --- Google (Drive, Gmail, Calendar) ---
# https://console.cloud.google.com/apis/credentials → OAuth client ID → Web app
# Enable the Drive, Gmail and Calendar APIs on the project first.
# NOTE: this is the SAME client used for Google sign-in. Add the connector
# redirect URI above alongside your existing sign-in one.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Microsoft 365 (Outlook, OneDrive, Calendar) ---
# https://portal.azure.com → Entra ID → App registrations → New registration
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Files ---
# https://www.dropbox.com/developers/apps
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
# https://app.box.com/developers/console
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=

# --- Notes & docs ---
# https://www.notion.so/my-integrations → New integration → Public integration
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# --- Tasks & projects ---
# https://developer.todoist.com/appconsole.html
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=
# https://linear.app/settings/api/applications/new
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# https://app.asana.com/0/my-apps
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
# https://trello.com/power-ups/admin
TRELLO_CLIENT_ID=
TRELLO_CLIENT_SECRET=
# https://app.clickup.com/settings/apps
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
# https://developer.atlassian.com/console/myapps → OAuth 2.0 (3LO)
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# --- Messaging ---
# https://api.slack.com/apps → Create New App → OAuth & Permissions
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- CRM & support ---
# https://developers.hubspot.com/ → Create app
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# https://<subdomain>.zendesk.com/admin/apps-integrations/apis/zendesk-api/oauth_clients
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=

# --- Design, data, meetings, music ---
# https://www.figma.com/developers/apps
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
# https://airtable.com/create/oauth
AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=
# https://marketplace.zoom.us/develop/create → OAuth
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# https://calendly.com/integrations/api_webhooks → Developer portal
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Web Push (Phase 4)
# ---------------------------------------------------------------------------
# A dev keypair ships in docker-compose.yml. Regenerate for production:
#   docker compose exec backend python -m app.scripts.generate_vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@infichat.app

# ---------------------------------------------------------------------------
# Image generation & storage
# ---------------------------------------------------------------------------
# Where generated image files are written. Inside Docker this must match the
# `backend_images` volume mount in docker-compose.yml — the database keeps only
# a relative path, so an unmounted directory means the rows survive a rebuild
# and the files do not.
IMAGE_STORAGE_DIR=/data/images

# Text-to-image provider. Point this at a self-hosted generator to keep prompts
# on your own infrastructure; see the Sub-processors page for what the default
# discloses (the prompt travels in the request URL).
IMAGE_PROVIDER_URL=https://image.pollinations.ai

# Diffusion is slow — a 1024x1024 render regularly takes 30-40s, and a shorter
# timeout turns a working request into a placeholder image.
IMAGE_GENERATION_TIMEOUT=90

# Grace period before a deleted image's row and file are erased for good.
# Deletion is a soft delete so an accidental tap is recoverable.
IMAGE_PURGE_AFTER_DAYS=30

# ---------------------------------------------------------------------------
# Company identity (frontend build args, not backend runtime)
# ---------------------------------------------------------------------------
# Printed on invoices and legal pages. Consumed by docker-compose.yml's
# `frontend-new.build.args` and inlined into the bundle by Vite at BUILD time —
# changing them requires `docker compose build frontend-new`, not a restart.
#
# Leave VITE_LEGAL_ENTITY_NAME blank until you have real details: the invoice
# generator then stamps every PDF as a DRAFT, which is far safer than printing
# a placeholder address on a document a customer may file for tax.
VITE_APP_NAME=InfiChat
VITE_APP_TAGLINE=AI assistant for teams
VITE_LEGAL_ENTITY_NAME=
# Newline- or pipe-separated, printed one line each.
# e.g. "Suite 100, 1 Example Street|Bengaluru 560001|India"
VITE_LEGAL_ADDRESS=
VITE_LEGAL_REGISTRATION_NUMBER=
VITE_LEGAL_TAX_ID=
VITE_PUBLIC_WEBSITE=infichat.ai
VITE_BILLING_EMAIL=billing@infichat.ai
VITE_SUPPORT_EMAIL=support@infichat.ai
VITE_PRIVACY_EMAIL=privacy@infichat.ai
VITE_SECURITY_EMAIL=security@infichat.ai
VITE_PAYMENT_PROCESSOR=Stripe
