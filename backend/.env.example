# Backend Environment Variables Example
#
# Copy to `backend/.env` and fill in. Never commit the real `.env`.

# ==============================================================================
# SECURITY — REQUIRED IN PRODUCTION
# ==============================================================================
# With ENVIRONMENT=production the app REFUSES TO START unless all three secrets
# below are set, at least 32 characters, and not one of the known-leaked values.
# In development they fall back to obvious insecure placeholders.
#
# Earlier releases shipped these as hardcoded defaults in app/core/config.py, so
# those specific values are in git history and are permanently compromised. If
# you ever ran with them, rotate now — see the rotation note below.
ENVIRONMENT=development

# JWT signing key. Anyone holding this can forge a token for any user.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your_secret_key_here

# Encrypts chat_messages.content, memories.content, shared_chats.snapshot_json.
# Must be a valid Fernet key (32 url-safe base64 bytes):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# CHANGING THIS ORPHANS EXISTING ENCRYPTED ROWS. Migrate them first:
#   python -m scripts.rotate_keys --old-key "<current>" --new-key "<new>"           # dry run
#   python -m scripts.rotate_keys --old-key "<current>" --new-key "<new>" --apply   # after backup
E2E_ENCRYPTION_KEY=

# Encrypts RAG documents at rest. Same Fernet format as above.
# No migration needed when setting this for the first time: documents indexed
# under the old leaked default were stored as plaintext and stay readable.
RAG_ENCRYPTION_KEY=

# Comma-separated origins allowed to call the API. Must NOT be "*" in
# production — credentialed CORS with a wildcard lets any site read
# authenticated responses.
ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated IPs/CIDRs of your reverse proxies (nginx, Cloudflare).
# X-Forwarded-For is trusted ONLY from these peers; otherwise any client could
# spoof the header to evade per-IP rate limits. Leave empty if not behind a proxy.
TRUSTED_PROXY_IPS=

# ==============================================================================
# INFRASTRUCTURE
# ==============================================================================
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/autoagent
REDIS_URL=redis://127.0.0.1:6379/0
CHROMA_URL=http://127.0.0.1:8001
LOG_LEVEL=INFO

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here

# Email Settings
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# Groq API Key for Chat & Reasoning
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# NVIDIA NIM API Key for Image Generation & Chat
HUGGINGFACE_API_KEY=your_huggingface_key_here
HUGGINGFACE_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Default Chat API Key (NVIDIA NIM — primary chat model)
DEFAULT_CHAT_API_KEY=your_nvidia_api_key_here
# Must exist on your provider. Check with GET /v1/models before changing —
# a model that does not exist 404s on every key and looks like a credential failure.
DEFAULT_CHAT_MODEL=meta/llama-3.1-70b-instruct

# Voyage AI API Key for Knowledge Base (RAG)
VOYAGE_API_KEY=your_voyage_key_here
VOYAGE_EMBEDDING_MODEL=voyage-3
VOYAGE_RERANK_MODEL=rerank-2.5

# Google Gemini API Key for Vision (Image Understanding)
GOOGLE_API_KEY=your_google_api_key_here
VISION_MODEL=gemini-1.5-flash

# Groq API Key for Speech-to-Text (STT)
GROQ_STT_API_KEY=your_groq_stt_key_here
GROQ_STT_MODEL=whisper-large-v3

# Unreal Speech API Key for Text-to-Speech (TTS)
UNREAL_SPEECH_API_KEY=your_unreal_speech_key_here
UNREAL_SPEECH_VOICE=Sierra

# Multi-Agent Code Orchestration (NVIDIA NIM — GLM 5.2)
PLANNER_API_KEY=your_nvidia_api_key_here
PLANNER_MODEL=z-ai/glm-5.2
CODER_API_KEY=your_nvidia_api_key_here
CODER_MODEL=z-ai/glm-5.2
