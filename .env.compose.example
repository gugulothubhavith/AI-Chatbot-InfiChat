# Compose-level variables. Interpolated into docker-compose.yml at `docker
# compose up`. Service secrets live in backend/.env, not here.

# ── First-boot admin bootstrap ──────────────────────────────────────────────
# Used ONCE, to create the very first admin account. After that account exists
# this only repairs its role/activation — it never touches the password, so
# changing the value below will not rotate an existing credential. Rotate from
# the console instead: Account → Change password.
#
# Leave SEED_ADMIN_PASSWORD empty. On a brand-new database a random password is
# generated and written to the backend logs exactly once.
SEED_ADMIN_EMAIL=gugulothubhavith2006@gmail.com
SEED_ADMIN_PASSWORD=

# Product name shown in the admin console shell.
VITE_APP_NAME=InfiChat
